# FIN — SpendWise's AI financial assistant
# 1. Copy this file and name the copy ".env" (in the same folder as main.py)
# 2. Paste ONE API key below:
#      Groq:      https://console.groq.com        (key starts with gsk_)
#      Anthropic: https://console.anthropic.com   (key starts with sk-ant-)
# 3. Restart SpendWise:  python main.py
# Never share .env or commit it to Git — it's already listed in .gitignore.

GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional settings
# FIN_PROVIDER=groq            (groq or anthropic; normally worked out from the key)
# FIN_MODEL=openai/gpt-oss-120b    (Groq default; Anthropic default is claude-sonnet-5-5)
# FIN_MAX_TOKENS=1200
# FIN_RATE_LIMIT=10

# Optional: a long random secret for SpendWise logins (recommended)
# SPENDWISE_SECRET_KEY=
